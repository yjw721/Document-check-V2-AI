{
  "meta": {
    "name": "自定义检测规则",
    "offline_only": true,
    "desc": "用户在界面【规则配置面板】中自建的规则，本地持久化，零联网。"
  },
  "groups": [
    {
      "id": "g_fmt_demo",
      "name": "格式规范示例组",
      "category": "format_error",
      "scope": "all",
      "enabled": true,
      "rules": [
        {
          "id": "r_demo1",
          "name": "禁止使用全角逗号后接空格",
          "enabled": true,
          "match_mode": "regex",
          "pattern": "，\\s",
          "severity": "low",
          "tag": "标点格式",
          "suggestion": "中文全角逗号后通常不需要空格，请检查中英文混排格式。"
        }
      ]
    },
    {
      "id": "g_expr_demo",
      "name": "表述规范示例组",
      "category": "expression",
      "scope": "all",
      "enabled": true,
      "rules": [
        {
          "id": "r_demo2",
          "name": "禁用口语词『咱们』",
          "enabled": true,
          "match_mode": "keyword",
          "pattern": "咱们",
          "severity": "medium",
          "tag": "口语化",
          "suggestion": "正式公文中建议使用「我们」代替「咱们」。"
        }
      ]
    },
    {
      "id": "ai_learning",
      "name": "本地AI学习",
      "category": "format_error",
      "scope": "all",
      "enabled": true,
      "rules": [
        {
          "id": "rdfebe962",
          "name": "用词错误",
          "enabled": true,
          "match_mode": "keyword",
          "pattern": "立马搞定",
          "severity": "medium",
          "tag": "本地AI自学习生成-人工校对样本",
          "suggestion": "尽快完成",
          "source": "ai_learning",
          "sample_id": "s460e9a22"
        },
        {
          "id": "r1d9d9b92",
          "name": "用词错误",
          "enabled": true,
          "match_mode": "keyword",
          "pattern": "尽快安排",
          "severity": "medium",
          "tag": "本地AI自学习生成-人工校对样本",
          "suggestion": "立即安排",
          "source": "ai_learning",
          "sample_id": "s460e9a22"
        },
        {
          "id": "r7498eb0a",
          "name": "语序错误",
          "enabled": true,
          "match_mode": "keyword",
          "pattern": "请尽快落实处理",
          "severity": "medium",
